From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sunu Aziz Rahayu <sunuazizrahayu@users.noreply.github.com>
Date: Fri, 26 Sep 2026 00:00:00 +0700
Subject: [PATCH] lineage: subtract Lineage charger via PRODUCT_PACKAGES

WITH_LINEAGE_CHARGER := false di patch sebelumnya ternyata no-op:
common_mobile.mk dibaca (lewat rantai inherit di baris pertama
lineage.mk) SEBELUM baris flag itu dieksekusi, jadi
lineage_charger_animation tetap masuk dan tabrakan dengan charger
treble tidak hilang.

Pakai PRODUCT_PACKAGES -= yang order-safe: dievaluasi setelah semua
inherit selesai, berlaku untuk semua varian (bvN4/bvNE/bgN4/bgNE).

---
 lineage.mk | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/lineage.mk b/lineage.mk
index 0000000..0000000 100644
--- a/lineage.mk
+++ b/lineage.mk
@@ -13,8 +13,10 @@ TARGET_BOOT_ANIMATION_RES := 1080
 # APN
 PRODUCT_PACKAGES += apns-conf.xml

-# Treble already provides its own charger images
-WITH_LINEAGE_CHARGER := false
+# Treble already provides its own charger images
+PRODUCT_PACKAGES -= \
+    lineage_charger_animation \
+    lineage_charger_animation_vendor

 #Oplus fingerprint
 $(call soong_config_set,surfaceflinger,udfps_lib,//hardware/oplus:libudfps_extension.oplus)
