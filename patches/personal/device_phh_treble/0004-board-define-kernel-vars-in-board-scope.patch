From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sunuazizrahayu <sunuazizrahayu@users.noreply.github.com>
Date: Fri, 26 Sep 2026 00:00:00 +0700
Subject: [PATCH] board: Define kernel vars in board scope via BoardConfigKernel

The vendor/lineage kernel header generator modules reference
$(KERNEL_BUILD_OUT_PREFIX) and $(TARGET_KERNEL_PLATFORM_TARGET),
which must be defined in board scope for Soong to see them
(plain product .mk scope is not exported). BoardConfigKernel.mk
covers KERNEL_BUILD_OUT_PREFIX and the whole kernel defaults
family; define the device-optional platform target empty here.
Neither module is ever built for GSI.
---
 board-base.mk | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/board-base.mk b/board-base.mk
index 2cb5dbc..9a2d9eb 100644
--- a/board-base.mk
+++ b/board-base.mk
@@ -1,3 +1,12 @@
+include vendor/lineage/config/BoardConfigKernel.mk
+
+# Kernel-less Treble products: kernel vars referenced by vendor/lineage
+# kernel header generator modules must be defined in board scope for
+# Soong to see them. BoardConfigKernel.mk covers KERNEL_BUILD_OUT_PREFIX;
+# TARGET_KERNEL_PLATFORM_TARGET is device-optional upstream, define empty.
+# Neither module is ever built for GSI.
+TARGET_KERNEL_PLATFORM_TARGET :=
+
 TARGET_SYSTEM_PROP := device/phh/treble/system.prop $(TARGET_SYSTEM_PROP)
 
 # Bluetooth
