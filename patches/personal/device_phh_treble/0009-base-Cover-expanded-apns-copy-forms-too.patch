From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sunuazizrahayu <sunuazizrahayu@users.noreply.github.com>
Date: Fri, 26 Sep 2026 00:00:00 +0700
Subject: [PATCH] base: Cover expanded apns copy forms too

The AOSP apns copy entry may already be expanded when base.mk is
evaluated, so the unexpanded -= form silently misses. List the
expanded forms as well; non-matching lines are harmless no-ops.
---
 base.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/base.mk b/base.mk
index 0dcb625..c6e7ed2 100644
--- a/base.mk
+++ b/base.mk
@@ -58,6 +58,8 @@ LOCAL_CHARGER_NO_UI := true
 # Lineage apns-conf.xml Soong module already provides this file; drop
 # the AOSP copy that would clash with it (kati "overriding commands").
 PRODUCT_COPY_FILES -= device/sample/etc/apns-full-conf.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/apns-conf.xml
+PRODUCT_COPY_FILES -= device/sample/etc/apns-full-conf.xml:system/product/etc/apns-conf.xml
+PRODUCT_COPY_FILES -= device/sample/etc/apns-full-conf.xml:product/etc/apns-conf.xml
 
 # USB Audio
 PRODUCT_COPY_FILES += \
-- 
2.54.0

