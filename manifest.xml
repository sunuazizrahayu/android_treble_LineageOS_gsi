<?xml version="1.0" encoding="UTF-8"?>
<!-- Local manifest MINIMAL untuk LineageOS 23.2 (Android 16) TrebleDroid GSI.
     Cara pakai: salin file ini ke .repo/local_manifests/manifest.xml
     di dalam source tree, lalu jalankan `repo sync`.
     Hanya berisi 3 project wajib agar GSI vanilla bisa ke-build dan boot.
     Butuh GApps / kompatibilitas vendor lama? Lihat README.md bagian
     "Menambah entri manifest (opsional)".
     Lihat setup.sh / README.md untuk alur lengkap. -->
<manifest>
    <remote name="github" fetch="https://github.com/" />

    <!-- Wajib: device tree GSI + HAL vendor TrebleDroid -->
    <project path="device/phh/treble" remote="github" name="TrebleDroid/device_phh_treble" revision="android-16.0" />
    <project path="vendor/interfaces" remote="github" name="TrebleDroid/vendor_interfaces" revision="android-16.0" />

    <!-- Hampir wajib: dependensi build Lineage, tanpa ini lunch target bisa gagal -->
    <project path="hardware/oplus" remote="github" name="LineageOS/android_hardware_oplus" revision="lineage-23.2" />
</manifest>
