<?xml version="1.0" encoding="UTF-8"?>
<!-- Local manifest MINIMAL untuk LineageOS 23.2 (Android 16) TrebleDroid GSI.
     Cara pakai: salin file ini ke .repo/local_manifests/manifest.xml
     di dalam source tree, lalu jalankan `repo sync`.
     Hanya berisi project wajib agar GSI vanilla bisa ke-build dan boot.
     Butuh varian GAPPS? Tambahkan entri berikut lalu sync ulang:
         <remote name="gitlab" fetch="https://gitlab.com/" />
         <project path="vendor/gapps" remote="gitlab" name="MindTheGapps/vendor_gapps" revision="baklava" />
     Lihat setup.sh / README.md untuk alur lengkap. -->
<manifest>
    <!-- <remote name="github" fetch="https://github.com/" /> -->

    <!-- Wajib: device tree GSI + HAL vendor TrebleDroid -->
    <project path="device/phh/treble" remote="github" name="TrebleDroid/device_phh_treble" revision="android-16.0" />
    <project path="vendor/interfaces" remote="github" name="TrebleDroid/vendor_interfaces" revision="android-16.0" />

    <!-- Hampir wajib: dependensi build Lineage, tanpa ini lunch target bisa gagal -->
    <project path="hardware/oplus" remote="github" name="LineageOS/android_hardware_oplus" revision="lineage-23.2" />

    <!-- Wajib: overlay tampilan per-device, di-include langsung oleh
         device/phh/treble/base.mk (tanpa ini lunch gagal:
         "vendor/hardware_overlay/overlay.mk does not exist") -->
    <project path="vendor/hardware_overlay" remote="github" name="AndroidROMx/vendor_hardware_overlay" revision="main" />

    <!-- Wajib: prebuilt VNDK Android 9. Tanpa ini lunch gagal di
         board_config.mk ("VNDK version 28 not found") -->
    <project path="prebuilts/vndk/v28" remote="github" name="naz664/prebuilts_vndk_v28" revision="master" />

    <!-- Wajib: prebuilt VNDK Android 10 dari AOSP (di-pin ke revisi tertentu
         agar unduhan kecil). Tanpa ini lunch gagal di board_config.mk
         ("VNDK version 29 not found") -->
    <project path="prebuilts/vndk/v29" remote="aosp" name="platform/prebuilts/vndk/v29" clone-depth="1" revision="bef5d37dda9360940964f097d612c8032e140961" />
    <project path="prebuilts/vndk/v30" remote="aosp" name="platform/prebuilts/vndk/v30" clone-depth="1" revision="5f9884aa352825291757dfd6694b874ad8c1805e" />

    <!-- Buang repo compat Lineage: modul prebuilt protobuf-nya bernama
         persis sama dengan prebuilt AOSP (prebuilts/misc) sehingga Soong
         gagal ("already defined"). Tidak dibutuhkan untuk build treble. -->
    <remove-project name="LineageOS/android_hardware_lineage_compat" />
</manifest>
